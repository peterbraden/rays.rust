# A small scene in NFF (Eric Haines' Neutral File Format), written by hand in the style of
# the SPD "balls" scene: z up, three lights, a mirrored sphere among smaller ones, on a floor.
v
from 2.1 1.3 1.7
at 0 0 0.1
up 0 0 1
angle 45
hither 0.01
resolution 512 512
b 0.078 0.361 0.753
l 4 3 2
l 1 -4 4
l -3 1 5
# floor
f 1 0.75 0.33 0.8 0 0 0 1
p 4
12 12 -0.5
-12 12 -0.5
-12 -12 -0.5
12 -12 -0.5
# mirrored balls
f 1 0.9 0.7 0.5 0.5 3 0 1
s 0 0 0 0.5
s 0.27 0.27 0.6 0.17
s -0.27 0.27 0.6 0.17
s 0.27 -0.27 0.6 0.17
s -0.27 -0.27 0.6 0.17
s 0.6 0.6 -0.35 0.15
s -0.6 0.6 -0.35 0.15
# a glass ball
f 1 1 1 0 0 0 0.9 1.5
s 0.65 -0.45 -0.25 0.25
# a tetrahedron of polygonal patches
f 0.4 0.7 1 0.9 0.1 20 0 1
pp 3
0.6 0 -0.5 0 -1 0
1.2 0 -0.5 0 -1 0
0.9 0 0 0 -1 0
p 3
1.2 0 -0.5
0.9 0.5 -0.5
0.9 0 0
p 3
0.9 0.5 -0.5
0.6 0 -0.5
0.9 0 0
