index 0000000..b5e6ab6
--- /dev/null
+++ b/naga/src/front/spv/ray_query.rs
@@ -0,0 +1,353 @@
+//! Parsing of ray queries (`SPV_KHR_ray_query`): the acceleration structure and ray query
+//! types, and the `OpRayQuery*KHR` instructions, into Naga's [`RayQuery`] statement and
+//! [`RayQueryGetIntersection`] expression.
+//!
+//! SPIR-V reads an intersection's properties one instruction each
+//! (`OpRayQueryGetIntersectionTKHR`, `...PrimitiveIndexKHR`, ...); Naga reads them all at once
+//! as a `RayIntersection` struct ([`SpecialTypes::ray_intersection`]), so each becomes a field of
+//! one. The properties of the ray itself (its origin, direction, `tmin` and flags), and those
+//! Naga's struct doesn't have, are not supported.
+//!
+//! [`RayQuery`]: crate::Statement::RayQuery
+//! [`RayQueryGetIntersection`]: crate::Expression::RayQueryGetIntersection
+//! [`SpecialTypes::ray_intersection`]: crate::SpecialTypes::ray_intersection
+
+use crate::front::spv::{
+    resolve_constant, BlockContext, Error, Frontend, LookupExpression, LookupHelper as _,
+    LookupType,
+};
+use crate::{Handle, RayQueryFunction, Statement};
+
+/// The fields of Naga's `RayIntersection` struct (`Module::generate_ray_intersection_type`).
+mod field {
+    pub const KIND: u32 = 0;
+    pub const T: u32 = 1;
+    pub const INSTANCE_CUSTOM_DATA: u32 = 2;
+    pub const INSTANCE_INDEX: u32 = 3;
+    pub const SBT_RECORD_OFFSET: u32 = 4;
+    pub const GEOMETRY_INDEX: u32 = 5;
+    pub const PRIMITIVE_INDEX: u32 = 6;
+    pub const BARYCENTRICS: u32 = 7;
+    pub const FRONT_FACE: u32 = 8;
+    pub const OBJECT_TO_WORLD: u32 = 9;
+    pub const WORLD_TO_OBJECT: u32 = 10;
+}
+
+impl<I: Iterator<Item = u32>> Frontend<I> {
+    /// `OpTypeAccelerationStructureKHR` and `OpTypeRayQueryKHR`.
+    pub(super) fn parse_type_ray_tracing(
+        &mut self,
+        inst: super::Instruction,
+        module: &mut crate::Module,
+    ) -> Result<(), Error> {
+        let start = self.data_offset;
+        self.switch(super::ModuleState::Type, inst.op)?;
+        inst.expect(2)?;
+        let id = self.next()?;
+        let inner = match inst.op {
+            spirv::Op::TypeAccelerationStructureKHR => crate::TypeInner::AccelerationStructure {
+                vertex_return: false,
+            },
+            _ => crate::TypeInner::RayQuery {
+                vertex_return: false,
+            },
+        };
+        let decor = self.future_decor.remove(&id).unwrap_or_default();
+        let handle = module.types.insert(
+            crate::Type {
+                name: decor.name,
+                inner,
+            },
+            self.span_from_with_op(start),
+        );
+        self.lookup_type.insert(
+            id,
+            LookupType {
+                handle,
+                base_id: None,
+            },
+        );
+        Ok(())
+    }
+
+    /// The `OpRayQuery*KHR` instructions in a function's body.
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn parse_ray_query(
+        &mut self,
+        inst: super::Instruction,
+        ctx: &mut BlockContext,
+        emitter: &mut crate::proc::Emitter,
+        block: &mut crate::Block,
+        block_id: spirv::Word,
+        body_idx: usize,
+    ) -> Result<(), Error> {
+        use spirv::Op;
+        let start = self.data_offset;
+        let span = crate::Span::from(start..(start + 4 * (inst.wc as usize)));
+
+        // An operand's expression, in the body being built.
+        macro_rules! operand {
+            () => {{
+                let id = self.next()?;
+                let lexp = self.lookup_expression.lookup(id)?;
+                self.get_expr_handle(id, lexp, ctx, emitter, block, body_idx)
+            }};
+        }
+        let statement = |fun,
+                         query,
+                         ctx: &mut BlockContext,
+                         emitter: &mut crate::proc::Emitter,
+                         block: &mut crate::Block| {
+            block.extend(emitter.finish(ctx.expressions));
+            block.push(Statement::RayQuery { query, fun }, span);
+            emitter.start(ctx.expressions);
+        };
+
+        match inst.op {
+            Op::RayQueryInitializeKHR => {
+                inst.expect(9)?;
+                let query = operand!();
+                // The acceleration structure is a handle: loading it (`OpLoad`) is the handle
+                // itself, and globals are in the root scope.
+                let acceleration_structure_id = self.next()?;
+                let acceleration_structure = self
+                    .lookup_expression
+                    .lookup(acceleration_structure_id)?
+                    .handle;
+                let flags = operand!();
+                let cull_mask = operand!();
+                let origin = operand!();
+                let tmin = operand!();
+                let dir = operand!();
+                let tmax = operand!();
+                let ty = ctx.module.generate_ray_desc_type();
+                let descriptor = ctx.expressions.append(
+                    crate::Expression::Compose {
+                        ty,
+                        components: alloc::vec![flags, cull_mask, tmin, tmax, origin, dir],
+                    },
+                    span,
+                );
+                statement(
+                    RayQueryFunction::Initialize {
+                        acceleration_structure,
+                        descriptor,
+                    },
+                    query,
+                    ctx,
+                    emitter,
+                    block,
+                );
+            }
+            Op::RayQueryProceedKHR => {
+                inst.expect(4)?;
+                let result_type_id = self.next()?;
+                let result_id = self.next()?;
+                let query = operand!();
+                block.extend(emitter.finish(ctx.expressions));
+                // The result is set by the statement, so is not emitted.
+                let result = ctx
+                    .expressions
+                    .append(crate::Expression::RayQueryProceedResult, span);
+                block.push(
+                    Statement::RayQuery {
+                        query,
+                        fun: RayQueryFunction::Proceed { result },
+                    },
+                    span,
+                );
+                emitter.start(ctx.expressions);
+                self.lookup_expression.insert(
+                    result_id,
+                    LookupExpression {
+                        handle: result,
+                        type_id: result_type_id,
+                        block_id,
+                    },
+                );
+            }
+            Op::RayQueryGenerateIntersectionKHR => {
+                inst.expect(3)?;
+                let query = operand!();
+                let hit_t = operand!();
+                statement(
+                    RayQueryFunction::GenerateIntersection { hit_t },
+                    query,
+                    ctx,
+                    emitter,
+                    block,
+                );
+            }
+            Op::RayQueryConfirmIntersectionKHR | Op::RayQueryTerminateKHR => {
+                inst.expect(2)?;
+                let query = operand!();
+                let fun = if inst.op == Op::RayQueryTerminateKHR {
+                    RayQueryFunction::Terminate
+                } else {
+                    RayQueryFunction::ConfirmIntersection
+                };
+                statement(fun, query, ctx, emitter, block);
+            }
+            Op::RayQueryGetIntersectionTypeKHR
+            | Op::RayQueryGetIntersectionTKHR
+            | Op::RayQueryGetIntersectionInstanceCustomIndexKHR
+            | Op::RayQueryGetIntersectionInstanceIdKHR
+            | Op::RayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetKHR
+            | Op::RayQueryGetIntersectionGeometryIndexKHR
+            | Op::RayQueryGetIntersectionPrimitiveIndexKHR
+            | Op::RayQueryGetIntersectionBarycentricsKHR
+            | Op::RayQueryGetIntersectionFrontFaceKHR
+            | Op::RayQueryGetIntersectionObjectToWorldKHR
+            | Op::RayQueryGetIntersectionWorldToObjectKHR => {
+                inst.expect(5)?;
+                let result_type_id = self.next()?;
+                let result_id = self.next()?;
+                let query = operand!();
+                // 0 for the candidate intersection, 1 for the committed one: a constant.
+                let which_id = self.next()?;
+                let which = self.lookup_constant.lookup(which_id)?;
+                let committed = match resolve_constant(ctx.gctx(), &which.inner) {
+                    Some(0) => false,
+                    Some(1) => true,
+                    _ => return Err(Error::InvalidRayQueryIntersection(which_id)),
+                };
+                let index = match inst.op {
+                    Op::RayQueryGetIntersectionTypeKHR => field::KIND,
+                    Op::RayQueryGetIntersectionTKHR => field::T,
+                    Op::RayQueryGetIntersectionInstanceCustomIndexKHR => {
+                        field::INSTANCE_CUSTOM_DATA
+                    }
+                    Op::RayQueryGetIntersectionInstanceIdKHR => field::INSTANCE_INDEX,
+                    Op::RayQueryGetIntersectionInstanceShaderBindingTableRecordOffsetKHR => {
+                        field::SBT_RECORD_OFFSET
+                    }
+                    Op::RayQueryGetIntersectionGeometryIndexKHR => field::GEOMETRY_INDEX,
+                    Op::RayQueryGetIntersectionPrimitiveIndexKHR => field::PRIMITIVE_INDEX,
+                    Op::RayQueryGetIntersectionBarycentricsKHR => field::BARYCENTRICS,
+                    Op::RayQueryGetIntersectionFrontFaceKHR => field::FRONT_FACE,
+                    Op::RayQueryGetIntersectionObjectToWorldKHR => field::OBJECT_TO_WORLD,
+                    _ => field::WORLD_TO_OBJECT,
+                };
+                ctx.module.generate_ray_intersection_type();
+                let intersection = ctx.expressions.append(
+                    crate::Expression::RayQueryGetIntersection { query, committed },
+                    span,
+                );
+                let mut value = ctx.expressions.append(
+                    crate::Expression::AccessIndex {
+                        base: intersection,
+                        index,
+                    },
+                    span,
+                );
+                if index == field::KIND && !committed {
+                    // A committed intersection's kind is numbered as Naga's
+                    // (`RayQueryIntersection`: none, triangle, generated), but a candidate's
+                    // isn't: SPIR-V has triangle 0 and AABB 1, Naga triangle 1 and AABB 3.
+                    // (Literals are in scope everywhere, so are made outside the emitter.)
+                    block.extend(emitter.finish(ctx.expressions));
+                    let mut literal = |value: u32| {
+                        ctx.expressions
+                            .append(crate::Expression::Literal(crate::Literal::U32(value)), span)
+                    };
+                    let aabb = literal(crate::RayQueryIntersection::Aabb as u32);
+                    let (one, zero) = (literal(1), literal(0));
+                    emitter.start(ctx.expressions);
+                    let is_aabb = ctx.expressions.append(
+                        crate::Expression::Binary {
+                            op: crate::BinaryOperator::Equal,
+                            left: value,
+                            right: aabb,
+                        },
+                        span,
+                    );
+                    value = ctx.expressions.append(
+                        crate::Expression::Select {
+                            condition: is_aabb,
+                            accept: one,
+                            reject: zero,
+                        },
+                        span,
+                    );
+                }
+                let value = self.with_result_type(value, result_type_id, ctx, span)?;
+                self.lookup_expression.insert(
+                    result_id,
+                    LookupExpression {
+                        handle: value,
+                        type_id: result_type_id,
+                        block_id,
+                    },
+                );
+            }
+            _ => return Err(Error::UnsupportedInstruction(self.state, inst.op)),
+        }
+        Ok(())
+    }
+
+    /// `value`, a field of the intersection, as the instruction's result type: SPIR-V lets an
+    /// integer property be signed, where Naga's field is unsigned.
+    fn with_result_type(
+        &self,
+        value: Handle<crate::Expression>,
+        result_type_id: spirv::Word,
+        ctx: &mut BlockContext,
+        span: crate::Span,
+    ) -> Result<Handle<crate::Expression>, Error> {
+        let ty = self.lookup_type.lookup(result_type_id)?.handle;
+        Ok(match ctx.module.types[ty].inner.scalar_kind() {
+            Some(crate::ScalarKind::Sint) => ctx.expressions.append(
+                crate::Expression::As {
+                    expr: value,
+                    kind: crate::ScalarKind::Sint,
+                    convert: None,
+                },
+                span,
+            ),
+            _ => value,
+        })
+    }
+}
+
+#[cfg(all(test, feature = "wgsl-in", feature = "wgsl-out"))]
+mod tests {
+    use crate::valid::{Capabilities, ValidationFlags, Validator};
+
+    /// A hit generated at a distance computed just before (not a constant, as in Naga's own
+    /// tests), read from WGSL, and written to WGSL and read again: the argument must be emitted
+    /// before the statement that uses it.
+    #[test]
+    fn a_generated_hit_at_a_computed_distance_is_in_scope() {
+        let source = r#"
+            enable wgpu_ray_query;
+            @group(0) @binding(0) var acs: acceleration_structure;
+            @group(0) @binding(1) var<storage, read_write> out: f32;
+            @compute @workgroup_size(1)
+            fn main() {
+                var rq: ray_query;
+                rayQueryInitialize(&rq, acs, RayDesc(0u, 0xFFu, 0.001, 1000.0, vec3<f32>(0.0), vec3<f32>(0.0, 0.0, 1.0)));
+                while (rayQueryProceed(&rq)) {
+                    let c = rayQueryGetCandidateIntersection(&rq);
+                    if (c.kind == 3u) {
+                        rayQueryGenerateIntersection(&rq, out * 2.0 + 1.0);
+                    }
+                }
+                out = rayQueryGetCommittedIntersection(&rq).t;
+            }
+        "#;
+        let validate = |module: &crate::Module| {
+            Validator::new(ValidationFlags::all(), Capabilities::RAY_QUERY)
+                .validate(module)
+                .unwrap_or_else(|e| panic!("{}", e.emit_to_string(source)))
+        };
+        let module = crate::front::wgsl::parse_str(source).unwrap();
+        let info = validate(&module);
+        let wgsl = crate::back::wgsl::write_string(
+            &module,
+            &info,
+            crate::back::wgsl::WriterFlags::empty(),
+        )
+        .unwrap();
+        validate(&crate::front::wgsl::parse_str(&wgsl).unwrap());
+    }
+}
