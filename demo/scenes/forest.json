  "camera": {
    "location": [0, 9, -95],
    "lookat": [0, 6, 120],
    "up": [0, 1, 0],
    "angle": 0.55,
    "aperture": 0.0
  },

  "lights": [
    { "location": [-560, 400, 420], "color": [1, 0.92, 0.8], "intensity": 2.4e6 }
  ],

  "objects": [
    { "type": "skysphere", "sun_direction": [-0.7, 0.5, 0.52] },
    { "type": "transform", "item": "land", "material": "GROUND" },
    { "type": "grass", "heightmap": "$land", "min": [-36, -88], "max": [36, -22], "density": 350, "seed": 5,
