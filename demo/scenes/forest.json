    "NEEDLE_1": { "type": "leaf", "reflectance": [0.04, 0.09, 0.04], "transmittance": [0.01, 0.04, 0.01], "roughness": 0.2 },
    "NEEDLE_2": { "type": "leaf", "reflectance": [0.05, 0.11, 0.04], "transmittance": [0.02, 0.05, 0.01], "roughness": 0.2 },
