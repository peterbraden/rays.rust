    "OAK_LEAF_2": { "type": "leaf", "reflectance": [0.09, 0.15, 0.05], "transmittance": [0.05, 0.13, 0.02],
      "autumn": { "reflectance": [0.4, 0.28, 0.08], "transmittance": [0.3, 0.2, 0.03] } },
    "WILLOW_LEAF": { "type": "leaf", "reflectance": [0.14, 0.2, 0.08], "transmittance": [0.1, 0.2, 0.04],
