# Compiled files
*.o
*.so
*.rlib
*.dll

# Executables
*.exe

# Generated by Cargo, here and in any crate below
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here http://doc.crates.io/guide.html#cargotoml-vs-cargolock
Cargo.lock


# Reference renders fetched by scripts/fetch-references.sh
/references/


# Simulation states cached by harris_cumulus scenes, and animation frames
.cumulus-cache/
# Trees grown by forests with a "cache"
.forest-cache/
/demo/scenes/*-frames/

# Saved render states (resumable renders)
*.accum
*.accum.tmp

# Terrain evolved by landscape scenes
.landscape-cache/
.claude/worktrees/

# The GPU shader, built from shaders/ by build.rs (scripts/build-shaders.sh)
/src/gpu/pathtrace.spv
/src/gpu/pathtrace.wgsl
/src/gpu/pathtrace.spv.sources
__pycache__/
