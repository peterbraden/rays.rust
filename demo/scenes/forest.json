{
  "width": 1200,
  "height": 600,

  "supersamples": 32,
  "chunk_size": 64,
  "samples_per_chunk": 2,
  "shadow_bias": 0.0001,
  "max_depth": 4,


  "variables": {
    "land": { "type": "noise", "min": [-460, -120], "max": [460, 760], "resolution": 440,
      "amplitude": 90, "scale": 260, "octaves": 5, "seed": 7 },
    "ASPEN": ["ASPEN_LEAF_1", "ASPEN_LEAF_2"],
    "NEEDLES": ["NEEDLE_1", "NEEDLE_2"],
    "PINE_NEEDLES": ["PINE_NEEDLE_1", "PINE_NEEDLE_2"]
