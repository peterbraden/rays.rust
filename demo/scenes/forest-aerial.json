    "FIR_NEEDLE": { "type": "leaf", "reflectance": [0.035, 0.08, 0.05], "transmittance": [0.01, 0.035, 0.015], "roughness": 0.2 },
    "CEDAR_NEEDLE": { "type": "leaf", "reflectance": [0.06, 0.1, 0.09], "transmittance": [0.02, 0.05, 0.03], "roughness": 0.2 },
    "CYPRESS": { "type": "leaf", "reflectance": [0.035, 0.07, 0.035], "transmittance": [0.01, 0.03, 0.01], "roughness": 0.2 },
    "PINE_NEEDLE_1": { "type": "leaf", "reflectance": [0.07, 0.13, 0.05], "transmittance": [0.03, 0.07, 0.01], "roughness": 0.2 },
    "PINE_NEEDLE_2": { "type": "leaf", "reflectance": [0.08, 0.13, 0.06], "transmittance": [0.03, 0.06, 0.02], "roughness": 0.2 },
    "HAZEL_LEAF": { "type": "leaf", "reflectance": [0.08, 0.17, 0.04], "transmittance": [0.06, 0.17, 0.02],
