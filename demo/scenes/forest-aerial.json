    "HAWTHORN_LEAF": { "type": "leaf", "reflectance": [0.06, 0.13, 0.035], "transmittance": [0.04, 0.11, 0.02],
      "autumn": { "reflectance": [0.42, 0.15, 0.05], "transmittance": [0.3, 0.08, 0.02] } },
    "GROUND": { "type": "soil", "preset": "forest_floor", "seed": 2 }
  },

  "geometries": {
    "land": { "type": "terrain", "heightmap": "$land" }
  },

  "camera": {
    "location": [0, 420, -760],
    "lookat": [0, 40, 600],
    "up": [0, 1, 0],
    "angle": 0.42,
    "aperture": 0.0
  },

  "sun": { "intensity": 4 },

  "objects": [
    { "type": "skysphere", "multiple_scattering": false, "sun_direction": [-0.5, 0.75, 0.6] },
    { "type": "transform", "item": "land", "material": "GROUND" },

    { "type": "forest", "seed": 21, "surface": "land", "lod": { "pixels": 1 },
      "area": { "min": [-1650, -560], "max": [1650, 2650] },
      "spacing": 10, "clearings": 0.22, "patch_size": 140, "patchiness": 0.8, "max_slope": 35,
      "variants": 6, "autumn": 0.45, "autumn_spread": 0.15,
      "species": [
        { "species": "scots-pine", "weight": 3, "bark": "PINE_BARK", "leaves": "$PINE_NEEDLES", "params": { "autumn": 0 } },
        { "species": "stone-pine", "weight": 1, "bark": "PINE_BARK", "leaves": "$PINE_NEEDLES", "params": { "autumn": 0 } },
        { "species": "norway-spruce", "weight": 3, "spacing": 0.8, "bark": "BARK", "leaves": "$NEEDLES", "params": { "autumn": 0 } },
        { "species": "balsam-fir", "weight": 2, "spacing": 0.7, "bark": "BARK", "leaves": "FIR_NEEDLE", "params": { "autumn": 0 } },
        { "species": "cedar-of-lebanon", "weight": 1, "spacing": 1.3, "bark": "BARK", "leaves": "CEDAR_NEEDLE", "params": { "autumn": 0 } },
        { "species": "italian-cypress", "weight": 0.5, "spacing": 0.4, "bark": "BARK", "leaves": "CYPRESS", "params": { "autumn": 0 } },
        { "species": "quaking-aspen", "weight": 3, "spacing": 0.7, "bark": "PALE_BARK", "dead_bark": "DEAD_WOOD", "leaves": "$ASPEN",
          "params": { "dead_branches": 0.05 } },
        { "species": "black-tupelo", "weight": 1, "spacing": 1.2, "bark": "BARK", "leaves": "TUPELO_LEAF" },
        { "species": "california-black-oak", "weight": 2, "spacing": 1.4, "bark": "BARK", "leaves": "$OAK" },
        { "species": "weeping-willow", "weight": 0.5, "spacing": 1.1, "bark": "BARK", "leaves": "WILLOW_LEAF" },
        { "species": "lombardy-poplar", "weight": 0.7, "spacing": 0.5, "bark": "PALE_BARK", "leaves": "POPLAR_LEAF" },
        { "species": "hazel", "weight": 1.5, "spacing": 0.45, "bark": "PALE_BARK", "leaves": "HAZEL_LEAF" },
        { "species": "hawthorn", "weight": 1, "spacing": 0.6, "bark": "BARK", "leaves": "HAWTHORN_LEAF" },
        { "species": "shrub", "weight": 2, "spacing": 0.3, "scale_v": 0.3, "bark": "BARK", "leaves": "SHRUB_LEAF" }
      ] }
  ]
}
